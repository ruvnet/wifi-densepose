--- a/mt76/mt7925/mcu.c
+++ b/mt76/mt7925/mcu.c
@@ -2125,6 +2125,8 @@
 int mt7925_mcu_set_sniffer(struct mt792x_dev *dev, struct ieee80211_vif *vif,
 			   bool enable)
 {
+	struct mt792x_vif *mvif = (struct mt792x_vif *)vif->drv_priv;
+	struct ieee80211_chanctx_conf *ctx = mvif->bss_conf.mt76.ctx;
 	struct {
 		struct {
 			u8 band_idx;
@@ -2146,6 +2148,15 @@
 			.enable = enable,
 		},
 	};
+
+	if (is_mt7927(&dev->mt76)) {
+		struct ieee80211_channel *chan;
+
+		chan = ctx ? ctx->def.chan : mvif->phy->mt76->chandef.chan;
+
+		if (chan)
+			req.hdr.band_idx = mt7925_band_idx(&dev->mt76, chan->band);
+	}
 
 	return mt76_mcu_send_msg(&dev->mt76, MCU_UNI_CMD(SNIFFER), &req, sizeof(req),
 				 true);
@@ -2205,6 +2216,9 @@
 			.drop_err = 1,
 		},
 	};
+
+	if (is_mt7927(mphy->dev))
+		req.hdr.band_idx = mt7925_band_idx(mphy->dev, chandef->chan->band);
 
 	if (chandef->chan->band < ARRAY_SIZE(ch_band))
 		req.tlv.ch_band = ch_band[chandef->chan->band];
